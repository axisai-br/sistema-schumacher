# App environment variables
VITE_API_URL=https://api.schumachertursc.com.br
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_TOKEN=
# Optional local debug user id sent as X-Debug-User-Id header.
VITE_DEBUG_USER_ID=
VITE_DEV_MODE=false
VITE_BOOKING_CHECKOUT_V2=true
VITE_LEGACY_MODE=false
# Atendimento: "auto" (padrao) usa /atendimento/* se a API tiver o v2 ligado e /chat/sessions* se nao; "true" ou "false" forcam um dos dois
VITE_ATENDIMENTO_V2=auto
