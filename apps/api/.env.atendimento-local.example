# Credenciais e opções do simulador local do atendimento v2.
# Copie este arquivo para apps/api/.env.atendimento-local (ele é ignorado pelo git)
# e preencha a chave. Variáveis já definidas no ambiente do sistema têm prioridade.

# ---- LLM (provedor) ----
# Provedor do LLM: nvidia (padrão) ou openai.
LLM_PROVEDOR=nvidia

# OBRIGATÓRIO com LLM_PROVEDOR=nvidia: chave da NVIDIA (obtenha em build.nvidia.com).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo do agente (e do juiz LLM). Padrão da NVIDIA: z-ai/glm-5.3 (rápido e com boas chamadas de ferramenta). Alternativas: deepseek-ai/deepseek-v4.1-flash, nvidia/nemotron-3-super-120b-a12b, moonshotai/kimi-k3 (lento; exige LLM_TEMPERATURA=1).
ATENDIMENTO_V2_MODELO=z-ai/glm-5.3

# Formato da saída JSON estruturada (nvidia): nvext | response_format | prompt.
LLM_MODO_JSON=nvext

# Esforço de raciocínio (nvidia): low | medium | high | max. Mais alto = mais lento.
LLM_REASONING_EFFORT=low

# Temperatura do modelo (nvidia).
LLM_TEMPERATURA=0.3

# Modelo reserva do hedge (nvidia). Padrão: nvidia/nemotron-3.5-lightning-30b-a3b (1-3 s). "off" desliga o reserva.
LLM_MODELO_RESERVA=nvidia/nemotron-3.5-lightning-30b-a3b

# Se o modelo principal não responder em N ms, o mesmo pedido vai ao reserva e vale a primeira resposta. 0 desliga.
LLM_HEDGE_MS=3000

# Desliga o raciocínio (chat_template_kwargs enable_thinking=false). Padrão: true só para o reserva; se definida, vale para os dois.
# LLM_SEM_RACIOCINIO=true

# OpenAI: opcional. Obrigatória só se LLM_PROVEDOR=openai (nesse caso use também
# ATENDIMENTO_V2_MODELO=gpt-4.1-mini); também serve para transcrever áudio.
# Para usar a OpenAI como LLM, troque LLM_PROVEDOR acima para openai.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Juiz (detecta pedido de humano / irritação) ----
# llm = usa o próprio LLM | jev = roteador Jev (precisa de TYPESAFE_API_KEY; 1 chamada por turno, responde saudação e lista de cidades sem LLM e pré-executa a busca) | off = sem juiz
ATENDIMENTO_V2_JUIZ=llm
# Só se ATENDIMENTO_V2_JUIZ=jev
TYPESAFE_API_KEY=

# ---- Regras de negócio ----
# Valor do sinal por passageiro pagante, em reais.
ATENDIMENTO_V2_SINAL_POR_PAGANTE=250

# ---- Modo -caso ----
# Modelo do cliente simulado por LLM. Vazio = o mesmo modelo do agente.
EVAL_MODELO_CLIENTE=
